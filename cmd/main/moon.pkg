import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x/sys",
  "vectie/moondesk/host",
  "vectie/moondesk/internal/fsx",
  "vectie/moondesk/internal/mooncore",
  "vectie/moondesk/internal/moonwiki",
  "vectie/moondesk/internal/pathx",
  "vectie/moondesk/internal/trusted_host_process" @trusted_host,
  "vectie/moondesk/plugin/moongate",
  "vectie/moondesk/packstudio",
  "vectie/moonlib/pack",
}

supported_targets = "native"

import {
  "moonbitlang/core/json",
} for "wbtest"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "-pthread -ldl" } },
  targets: { "main.mbt": [ "native" ], "main_stub.mbt": [ "not", "native" ] },
)
