{
  "name": "moondesk-rabbita",
  "private": true,
  "type": "module",
  "scripts": {
    "test:i18n": "node --test moonsuite-i18n.test.mjs",
    "test:workspace-features": "node --test workspace-features-runtime.test.mjs",
    "test:workspace-performance": "node --test workspace-features-performance.test.mjs",
    "test:mooncode-devtools": "node --test mooncode-developer-tools-runtime.test.mjs",
    "test:bundle": "node --test bundle-split.test.mjs",
    "predev": "moon build --target js --debug && node prepare-rabbita-build.mjs debug",
    "dev": "vite --host 127.0.0.1 --port 5188",
    "prebuild": "moon build --target js --release && node prepare-rabbita-build.mjs release",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4188"
  },
  "dependencies": {
    "@rabbita/vite": "^0.2.0"
  },
  "devDependencies": {
    "terser": "^5.50.0",
    "vite": "^7.0.0"
  }
}
