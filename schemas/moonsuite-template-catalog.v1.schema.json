{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectie.github.io/moonsuite/contracts/moonsuite.template-catalog.v1.schema.json",
  "title": "MoonSuite Template Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "catalog_id", "owner_product", "version", "catalog_digest", "templates"],
  "properties": {
    "contract_id": {"const": "moonsuite.template-catalog.v1"},
    "catalog_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "owner_product": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "catalog_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the exact UTF-8 catalog file after replacing this single value with sha256: followed by 64 zeroes. Together with catalog and template identity/version, this is the template definition identity."
    },
    "templates": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "moonsuite-template-envelope.v1.schema.json"}
    }
  }
}
